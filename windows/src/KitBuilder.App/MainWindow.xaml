<Window
    x:Class="KitBuilder.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="CS2 Kit Builder">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid x:Name="TitleBar" Grid.Row="0">
            <TextBlock Text="CS2 Kit Builder" Margin="16,0,0,0" VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>
        <NavigationView x:Name="Nav" Grid.Row="1" IsSettingsVisible="False" IsBackButtonVisible="Collapsed"
                        PaneDisplayMode="Left" OpenPaneLength="200" SelectionChanged="OnNavigate">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Montar kit" Tag="kit" Icon="Shop" IsSelected="True" />
                <NavigationViewItem Content="Inventário" Tag="inventory" Icon="Library" />
                <NavigationViewItem Content="Kits salvos" Tag="saved" Icon="Save" />
                <NavigationViewItem Content="Sobre" Tag="about" Icon="Help" />
            </NavigationView.MenuItems>
            <Grid>
                <Frame x:Name="ContentFrame" />
                <TextBlock x:Name="Placeholder" Text="Em breve." Visibility="Collapsed" Margin="32"
                           Style="{StaticResource SubtitleTextBlockStyle}" />
            </Grid>
        </NavigationView>
        <Grid Grid.Row="2" Padding="16,6">
            <TextBlock x:Name="StatusText" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"
                       Text="Preço aproximado do Mercado da Steam." />
        </Grid>
    </Grid>
</Window>
